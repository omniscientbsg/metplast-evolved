# ── Copy to .env (local) and set the same vars in your production host env (Hostinger panel / Docker env) ──

# MySQL 8 (local Docker for dev; Hostinger managed MySQL in production).
DATABASE_URL="mysql://metplast:metplastpass@localhost:3306/metplast"

# Where product/gallery image uploads are written. In Docker, mount a volume
# here so uploads survive redeploys. Must be under ./public to be served.
UPLOAD_DIR="./public/uploads"

# NextAuth — REQUIRED. There is NO hard-coded fallback: if NEXTAUTH_SECRET is
# unset, NextAuth throws and admin auth will not work. Generate one with:
#   openssl rand -base64 32
NEXTAUTH_SECRET="replace-with-a-long-random-string"
# The site's public URL (used by NextAuth for callbacks in production).
NEXTAUTH_URL="https://your-domain.com"

# Admin accounts — used only by the seed / password-reset scripts, not at runtime.
# ADMIN_EMAILS is a comma-separated list; every listed email gets an admin
# account with the same ADMIN_PASSWORD. Never commit real values. Password must
# be at least 8 characters. Change it after first login.
ADMIN_EMAILS="admin@metplast.com"
ADMIN_PASSWORD="set-a-strong-unique-password"

# NOTE: Chatbot API keys (Gemini / OpenAI / Anthropic) are NOT set here —
# they are entered in the admin dashboard (Chatbot & AI) and stored in the DB.
